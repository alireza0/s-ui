#!/bin/sh /etc/rc.common

USE_PROCD=1
START=99

start_service() {
    # Ensure sing-box symlink exists in /etc/s-ui if needed, or link it to where s-ui looks for it
    mkdir -p /etc/s-ui
    [ -e /etc/s-ui/sing-box ] || ln -s /usr/sbin/sing-box /etc/s-ui/sing-box

    procd_open_instance
    procd_set_param command /usr/bin/sui
    procd_set_param env SUI_DB_FOLDER=/etc/s-ui SUI_BIN_FOLDER=/etc/s-ui
    procd_set_param respawn
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
